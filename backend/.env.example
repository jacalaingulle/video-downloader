# Copy to .env and adjust. Every value is optional.

PORT=4000
# NODE_ENV=production

# Number of reverse proxies in front of the app (1 on Render, Railway, Fly.io, or behind Nginx).
# Needed so rate limits apply per visitor instead of to the proxy.
TRUST_PROXY=0

# Optional family passcode. When set, visitors must enter it once (remembered for 30 days per browser).
# SITE_PASSCODE=

# Only when the frontend is hosted on a different domain, e.g. https://spectra.example.com
CORS_ORIGINS=

# Defaults: backend/bin/yt-dlp (downloaded on npm install) and the bundled ffmpeg.
# YTDLP_PATH=
# FFMPEG_PATH=

# Update yt-dlp on start and once a day. Recommended in production: YouTube changes often.
YTDLP_AUTO_UPDATE=false

# Hosting providers' IPs are often challenged by YouTube ("confirm you're not a bot").
# A cookies.txt export from a logged-in browser, or a residential proxy, avoids it.
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# YTDLP_PROXY=http://user:pass@host:port

# Where files are prepared. Wiped on start; each file is deleted FILE_TTL_MINUTES after it is ready.
# DOWNLOAD_DIR=
FILE_TTL_MINUTES=20

MAX_CONCURRENT_JOBS=3
MAX_DURATION_MINUTES=180
JOB_TIMEOUT_MINUTES=30

# Requests per visitor per 15 minutes
RATE_LIMIT_INFO=60
RATE_LIMIT_DOWNLOAD=15

# Folder with the built frontend. Default: ../frontend/dist/frontend/browser
# STATIC_DIR=
